# Gemfile for GitHub Pages (optional: run `bundle install` and `bundle exec jekyll serve` locally)
# On GitHub Pages the site builds with github-pages. For Ruby 3+ locally use: gem "github-pages"
source "https://rubygems.org"
gem "csv"         # required by Jekyll on Ruby 4.0+ (removed from default gems)
gem "bigdecimal"  # required by Liquid on Ruby 4.0+
gem "liquid", "~> 4.0.4"  # Ruby 3.2+ compatibility (github-pages pins 4.0.3 which uses removed tainted?)
gem "github-pages", group: :jekyll_plugins
